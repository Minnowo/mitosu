# Example systemd user unit for `mitosu serve`. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/mitosu.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now mitosu
# Logs: journalctl --user -u mitosu
# To keep it running while you are logged out: loginctl enable-linger

[Unit]
Description=mitosu server mode (pulls kanshi history, serves the web UI)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/mitosu serve
Restart=on-failure
RestartSec=10
# Uses the ssh-agent of your session if one is set up for systemd;
# otherwise keys must be unencrypted files.

[Install]
WantedBy=default.target
